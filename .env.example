# 上傳前請改名為 .env.example
# 學生使用時再複製一份改名為 .env，並填入自己的金鑰
#
# .env 已被 .gitignore 排除，絕對不要 commit
# 這個 .env.example 檔案本身「不含真實金鑰」，可以安全進版控

# ── 第 7 章：LLM API 金鑰 ──────────────────────────
# 申請方式見第 7.5 節「免費 LLM 選項與使用限制」
LLM_API_KEY=

# ── Flask 設定 ────────────────────────────────────
# 第 6、7 章都使用 8051，同時只能跑一個
FLASK_PORT=8051
FLASK_DEBUG=1

# ── 資料庫路徑（相對於各章 project 資料夾）────────
DATABASE_PATH=app.db
